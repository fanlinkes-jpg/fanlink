{
  "name": "fanlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestión local de sesiones de OnlyFans. El login lo hace una persona en una ventana de Chromium; Fanlink solo guarda el storage state.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "browser": "playwright install chromium"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
